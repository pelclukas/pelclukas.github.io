# Zkopiruj jako .env a vypln. .env je v .gitignore a nikdy se necommituje.
#
#   cp .env.example .env
#
# Komentarem je jen cely radek zacinajici na #. Uvnitr hodnoty se # bere
# doslova, takze heslo s # se neusekne.

# BrowserStack - https://www.browserstack.com/accounts/settings/product
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=

# Vyplnit jen tehdy, kdyz byl tunnel spusteny s --local-identifier.
# Z desktopove aplikace obvykle zadny nema - pak radek nech zakomentovany.
# BROWSERSTACK_LOCAL_IDENTIFIER=

# Staging Livendo FE - bez koncoveho lomitka, dostupny jen pres firemni VPN
LIVENDO_BASE_URL=
LIVENDO_EMAIL=
LIVENDO_PASSWORD=

# Id existujiciho provereni pro test detailu, at se kvuli nemu nemusi platit.
LIV396_DETAIL_ID=

# Testovaci osoba. Vychozi je kontrolni cista osoba, u ktere se necekaji
# zadne zaznamy - beh pak nezavisi na obsahu rejstriku.
# LIV396_FIRST_NAME=
# LIV396_LAST_NAME=
# LIV396_BIRTH_DATE=

# 0 = nedokoncovat platbu ani v deep rezimu
# LIV396_ALLOW_PAYMENT=1
# 1 = vynechat landscape session
# LIV396_SKIP_LANDSCAPE=0
# Carkou oddelene slugy z devices.js, prazdne = cela matice
# DEVICES=
